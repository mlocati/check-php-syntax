{
  "name": "@mlocati/check-php-syntax",
  "version": "1.0.0",
  "description": " A GitHub Action that checks if a directory contains PHP files with valid syntax",
  "keywords": [
    "php",
    "check",
    "syntax",
    "github",
    "action"
  ],
  "homepage": "https://github.com/mlocati/check-php-syntax",
  "bugs": {
    "url": "https://github.com/mlocati/check-php-syntax/issues"
  },
  "license": "MIT",
  "author": "Michele Locati <michele@locati.it>",
  "type": "module",
  "engines": {
    "node": "^24.13"
  },
  "scripts": {
    "prebuild": "shx rm -rf dist",
    "build": "npx rollup --config rollup.config.js",
    "postbuild": "shx cp src/checker.php dist/"
  },
  "dependencies": {
    "@actions/core": "^3.0.0",
    "@actions/exec": "^3.0.0",
    "shescape": "^2.1.10"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "rollup": "^4.59.0",
    "shx": "^0.4.0"
  }
}
